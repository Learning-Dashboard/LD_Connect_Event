# Set to True to enable debug mode, which will print more detailed logs and error messages. Set to False for production use.
DEBUG=False

# Flask server settings (only used when running python app.py directly)
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=mongo
MONGO_USER=
MONGO_PASS=
MONGO_AUTHSRC=

# Per-subject credentials: GitHub token, Taiga server and Taiga credentials of
# each subject, plus the teams that belong to it. Start from
# config_files/credentials_config.example.json (see README.md).
# Relative paths are resolved from the project root. In Docker, the default
# expects ./config_files to be mounted into /app/config_files.
CREDENTIALS_FILE=config_files/credentials_config.json

#### GitHub configuration

# The GitHub token is not configured here: each subject has its own
# "github_token" in the credentials config.

#This is the secret key that we will use to verify the signature. I must be the same as the one in the webhook
GITHUB_SIGNATURE_KEY="myGHS3cr3t!"

# GitHub API URL (default: https://api.github.com, change for GitHub Enterprise)
GITHUB_API_URL=https://api.github.com

#### Taiga configuration

# Fallback Taiga: used by every subject that leaves "taiga_api_url" and
# "taiga_auth_url" empty in the credentials config (subjects without a Taiga
# server of their own). The user and password are only used when the subject
# has no Taiga credentials of its own either.
# TAIGA_FALLBACK_AUTH_URL is the full login endpoint (it ends in /auth).
TAIGA_FALLBACK_API_URL=https://api.taiga.io/api/v1
TAIGA_FALLBACK_AUTH_URL=https://api.taiga.io/api/v1/auth
TAIGA_FALLBACK_USERNAME=
TAIGA_FALLBACK_PASSWORD=

#This is the secret key that we will use to verify the signature. I must be the same as the one in the webhook
TAIGA_SIGNATURE_KEY="asdqasfs"

# URLS de los webhooks
WEBHOOK_URL_GITHUB="https://gessi-dashboard.essi.upc.edu/webhook/github"
WEBHOOK_URL_TAIGA= "https://gessi-dashboard.essi.upc.edu/webhook/taiga"
