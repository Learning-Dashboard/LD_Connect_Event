FLASK_HOST=127.0.0.1
FLASK_PORT=5000

MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=mongo
MONGO_USER=
MONGO_PASS=
MONGO_AUTHSRC=


